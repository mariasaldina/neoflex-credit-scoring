<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-client" author="mariasaldina">
        <createTable tableName="client">
            <column name="client_id" type="uuid">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="last_name" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="first_name" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="middle_name" type="varchar(255)" />
            <column name="birthdate" type="date">
                <constraints nullable="false" />
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="gender" type="varchar(20)" />
            <column name="marital_status" type="varchar(255)" />
            <column name="dependent_amount" type="int" />
            <column name="account_number" type="varchar(30)" />
            <column name="passport_id" type="uuid" />
            <column name="employment_id" type="uuid" />
        </createTable>
    </changeSet>

</databaseChangeLog>