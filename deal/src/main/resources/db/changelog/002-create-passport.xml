<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-passport" author="mariasaldina">
        <createTable tableName="passport">
            <column name="passport_id" type="uuid">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="series" type="varchar(4)">
                <constraints nullable="false" />
            </column>
            <column name="number" type="varchar(6)">
                <constraints nullable="false" />
            </column>
            <column name="issue_branch" type="varchar(255)" />
            <column name="issue_date" type="date" />
        </createTable>
    </changeSet>

</databaseChangeLog>